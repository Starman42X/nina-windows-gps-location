<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The Windows 10 TFM gives access to Windows.Devices.Geolocation (WinRT) -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <AssemblyName>NINA.Plugin.WindowsGpsLocation</AssemblyName>
    <RootNamespace>WindowsGpsLocation</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- NU1701: old .NET Framework packages pulled in by NINA itself; CA1416: WinRT APIs are Windows-only, as is N.I.N.A. -->
    <NoWarn>$(NoWarn);NU1701;CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Provided by N.I.N.A. at runtime: compile against it, don't ship it -->
    <PackageReference Include="NINA.Plugin" Version="3.2.0.9001" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
