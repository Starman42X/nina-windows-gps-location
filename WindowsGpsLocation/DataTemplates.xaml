<ResourceDictionary
    x:Class="WindowsGpsLocation.DataTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:WindowsGpsLocation"
    xmlns:mini="clr-namespace:NINA.View.Sequencer.MiniSequencer;assembly=NINA.Sequencer"
    xmlns:nina="clr-namespace:NINA.View.Sequencer;assembly=NINA.Sequencer">

    <!--  Map pin icon for the sequencer instruction  -->
    <GeometryGroup x:Key="WindowsGpsLocation_PinSVG">
        <PathGeometry Figures="M12,2C8.13,2 5,5.13 5,9c0,5.25 7,13 7,13s7,-7.75 7,-13c0,-3.87 -3.13,-7 -7,-7zM12,11.5c-1.38,0 -2.5,-1.12 -2.5,-2.5s1.12,-2.5 2.5,-2.5 2.5,1.12 2.5,2.5 -1.12,2.5 -2.5,2.5z" />
    </GeometryGroup>

    <DataTemplate DataType="{x:Type local:SetLocationFromWindowsGps}">
        <nina:SequenceBlockView>
            <nina:SequenceBlockView.SequenceItemContent>
                <TextBlock VerticalAlignment="Center" Opacity="0.7" Text="Sets latitude, longitude and elevation from the Windows location service" />
            </nina:SequenceBlockView.SequenceItemContent>
        </nina:SequenceBlockView>
    </DataTemplate>

    <DataTemplate x:Key="WindowsGpsLocation.SetLocationFromWindowsGps_Mini">
        <mini:MiniSequenceItem />
    </DataTemplate>
</ResourceDictionary>
